# ============================================================
# TÄZE HR AGENTLIK GURNALYŞY (Kerwen-i bozmaýar)
# Bu faýly göçürip .env ediň — Kerwen kompýuterinde ulanmaň!
# ============================================================

PORT=8000
HTTPS_PORT=8443
HTTPS_ENABLED=1
NODE_ENV=production

# --- Marka (UI + Windows EXE / bellikler) ---
BRAND_SHORT=SiziňAdyňyz
BRAND_FULL=SiziňAdyňyz Agenstwa
BRAND_PANEL_TITLE=SiziňAdyňyz Panel
BRAND_TAGLINE=Kadrlar Agentligi
BRAND_HERO_TEXT=SiziňAdyňyz Agenstwa — işe ýerleşmek üçin ygtybarly hyzmat.
BRAND_LOGO_URL=/assets/logo.png
BRAND_FAVICON_URL=/assets/favicon.png

# --- Hukuk / şertnama maglumaty ---
COMPANY_NAME=Siziň Firma Adyňyz
COMPANY_DIRECTOR=
COMPANY_DIRECTOR_SHORT=
COMPANY_EMAIL=info@example.com
COMPANY_PHONE=
COMPANY_ADDRESS=
COMPANY_BANK=
COMPANY_ACCOUNT=
COMPANY_MFO=
COMPANY_SSB=

# --- Baza (HER AGENTLIK ÜÇIN AÝRATYN!) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=agency2_kadr
DB_USER=postgres
DB_PASSWORD=gizlin

# --- Howpsuzlyk (hökman täze!) ---
JWT_SECRET=ozunuzin_uzyn_gizlin_sozunuz
JWT_EXPIRES_IN=7d
PUBLIC_SITE_KEY=agency2-open
PUBLIC_COOKIE_NAME=agency2_public

# --- E-poçta (islege görä) ---
MAIL_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================================
# GURNAMA ÄDIMLERI (Kerwen işläp duran kompýuterde däl!):
# 1) Kod göçüriň (git clone ýa-da zip)
# 2) Bu faýly .env ediň we ýokardaky maglumatlary dolduryň
# 3) public/assets/logo.png — öz logonyňyzy goýuň
# 4) PostgreSQL-de täze DB: CREATE DATABASE agency2_kadr;
# 5) npm install && npm run db:sync && npm run db:seed
# 6) npm start
# 7) Windows paneli: powershell -File tools\install-kerwen.ps1
#    → Desktopda «SiziňAdyňyz Panel», LocalAppData\SiziAdyzKadr
# Kerwen-iň .env / DB / LocalAppData\KerwenKadr — ellemäň!
# ============================================================
